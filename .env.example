# Copy to .env and fill in. .env is gitignored - never commit it.

# Workspace URL. Scheme optional; env.sh strips it for dbt.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# SQL Warehouse -> your warehouse -> Connection details -> HTTP path
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx

# Settings -> Developer -> Access tokens
# In CI use a service principal OAuth secret instead - a PAT dies with its owner.
DATABRICKS_TOKEN=

# Unity Catalog catalog to build into
DBT_CATALOG=workspace
